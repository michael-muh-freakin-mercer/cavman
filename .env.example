# Cavman API and worker configuration. Copy to `.env` (gitignored) and fill in.
# Never commit real secrets. The web app has its own file: web/.env.example.

# --- Service boundary (required) --------------------------------------------
# Shared secret the web server presents on every API call. Browsers never see it.
# Generate with: openssl rand -hex 32   (minimum 32 characters)
CAVMAN_API_TOKEN=

# Where Cavman keeps platform state, the operational database, project
# repositories and delivery archives. Use a persistent volume in production.
CAVMAN_DATA_DIR=.local/cavman

# development | production. Production refuses the scripted test executor and
# hides the interactive API docs.
CAVMAN_ENV=development

# provider (real models, needs OPENROUTER_API_KEY) | scripted (credit-free test
# executor: scripted models, real kernel and sandbox; refused in production).
CAVMAN_EXECUTOR=provider

# workflow is the only mode: plain code drives plan -> delegate -> validate ->
# review -> accept -> recover; models only plan, do the work and review. The
# Manager-driven mode was retired on 2026-10-02 and is refused at startup.
CAVMAN_ORCHESTRATION=workflow

# --- Candidate code isolation (worker; the API reports it in health) --------
# bubblewrap (default): Linux namespaces on the worker host (needs user
# namespaces; see deploy/README.md). e2b: every check runs in a fresh E2B
# microVM; install with `pip install '.[e2b]'` and build the template once with
# `python scripts/e2b_template.py`.
# CAVMAN_SANDBOX_BACKEND=bubblewrap
# E2B_API_KEY=
# CAVMAN_E2B_TEMPLATE=cavman-sandbox

# --- Model provider (worker only) --------------------------------------------
# Required for CAVMAN_EXECUTOR=provider. The placeholder value is rejected.
OPENROUTER_API_KEY=your_openrouter_key_here
WALTER_MODEL_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Manager and specialist models. Any tool-calling model on OpenRouter works,
# e.g. moonshotai/kimi-k3, deepseek/..., qwen/...
WALTER_MODEL=moonshotai/kimi-k3
WALTER_WORKER_MODEL=moonshotai/kimi-k3
# WALTER_WORKER_MAX_TURNS=24

# Optional model modes users can pick per build (Automatic always uses the two
# models above). Each is "manager=<planner/manager model>,worker=<specialist model>".
# CAVMAN_MODELS_BUDGET=manager=deepseek/deepseek-chat,worker=qwen/qwen3-coder
# CAVMAN_MODELS_BALANCED=manager=moonshotai/kimi-k3,worker=deepseek/deepseek-chat
# CAVMAN_MODELS_QUALITY=manager=moonshotai/kimi-k3,worker=moonshotai/kimi-k3

# --- Spending protection -----------------------------------------------------
# Every run gets a USD ceiling (enforced on provider-reported cost) and a
# model-call ceiling (which also bounds calls whose cost was not reported).
CAVMAN_DEFAULT_BUDGET_USD=5
CAVMAN_MAX_BUDGET_USD=100
CAVMAN_DEFAULT_MAX_MODEL_CALLS=300
# Per-account monthly ceilings across all runs (new work is refused once reached).
CAVMAN_ACCOUNT_MONTHLY_BUDGET_USD=25
CAVMAN_ACCOUNT_MONTHLY_MAX_CALLS=3000
# Optional global caps applied on top of per-run budgets (stricter wins):
# WALTER_MAX_COST_USD=20
# WALTER_MAX_MODEL_CALLS=500
# WALTER_MAX_INPUT_TOKENS=5000000
# WALTER_MAX_OUTPUT_TOKENS=1000000
# WALTER_MAX_TOTAL_TOKENS=6000000

# --- Worker tuning (optional) ------------------------------------------------
# CAVMAN_WORKER_CONCURRENCY=1     # jobs one worker process runs at once
# CAVMAN_LEASE_SECONDS=90         # a silent worker's job is recovered after this
# CAVMAN_HEARTBEAT_SECONDS=5
# CAVMAN_MAX_RECOVERIES=3         # automatic recoveries per run after worker loss
# CAVMAN_MAINTENANCE_INTERVAL_SECONDS=3600  # retire finished runs' worktrees, prune caches
# CAVMAN_NODE_DEPS_MAX_AGE_DAYS=7
# CAVMAN_SCRIPTED_STEP_DELAY=0.25 # scripted executor only
# CAVMAN_LOG_LEVEL=INFO
# CAVMAN_LOG_FORMAT=json           # one JSON object per log line
# SENTRY_DSN=                        # report API and worker errors to Sentry (needs the [sentry] extra)
# SENTRY_ENVIRONMENT=production
# CAVMAN_METRICS_TOKEN=            # enables GET /api/metrics (Prometheus) with this bearer token
# Ship container logs to Grafana Cloud Logs (compose.prod.yaml only; see docs/DEPLOY_DIGITALOCEAN.md, "Logs"):
# COMPOSE_PROFILES=logs
# GRAFANA_LOKI_URL=                  # https://<logs host>/loki/api/v1/push
# GRAFANA_LOKI_USER=
# GRAFANA_LOKI_TOKEN=                # access policy token with the logs:write scope only

# --- Operational database (API and workers) --------------------------------
# Unset: SQLite files in CAVMAN_DATA_DIR (one host). For several hosts:
# CAVMAN_DATABASE_URL=postgresql://user:password@host:5432/cavman
# CAVMAN_DATABASE_SCHEMA=cavman   # tables go in <schema>_ops and <schema>_platform

# --- Per-account limits (API process) -----------------------------------
# CAVMAN_BUILDS_PER_HOUR=20        # new builds and continuations
# CAVMAN_IMPORTS_PER_HOUR=5
# CAVMAN_ACTIONS_PER_MINUTE=60     # approvals, stop, close, budget, delivery, publish
# CAVMAN_MAX_CONCURRENT_BUILDS=2
# CAVMAN_MAX_PROJECTS=100
# CAVMAN_ACCOUNT_DISK_MB=2048      # project repositories plus delivery archives

# --- Starting from a public GitHub repository (API process) ---------------
# The API needs outbound HTTPS to api.github.com and github.com for this.
# CAVMAN_IMPORT_MAX_MB=100         # 0 disables imports
# CAVMAN_IMPORT_MAX_FILES=5000
# CAVMAN_GITHUB_IMPORT_TOKEN=      # any GitHub token (no scopes); raises the 60/hour anonymous limit
