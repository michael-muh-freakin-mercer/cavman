# Required: OpenRouter API key (never commit a real key).
OPENROUTER_API_KEY=your_openrouter_key_here
CAVEMAN_MODEL_PROVIDER=openrouter

# Optional model and endpoint overrides.
CAVEMAN_MODEL=moonshotai/kimi-k3
CAVEMAN_WORKER_MODEL=moonshotai/kimi-k3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional per-run usage budget. All are optional; leave unset for unlimited.
# Malformed (non-integer or negative) values fail configuration.
# CAVEMAN_MAX_MODEL_CALLS=100
# CAVEMAN_MAX_INPUT_TOKENS=1000000
# CAVEMAN_MAX_OUTPUT_TOKENS=500000
# CAVEMAN_MAX_TOTAL_TOKENS=1500000
