# Cavman web app configuration. Copy to `web/.env.local` (gitignored).

# Private Cavman API (never exposed to browsers) and the shared service token.
CAVMAN_API_URL=http://127.0.0.1:8000
CAVMAN_API_TOKEN=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this web app (used for OAuth callbacks and redirects).
BETTER_AUTH_URL=http://localhost:3000

# Auth storage: a postgres:// URL for managed Postgres, or a SQLite file path.
AUTH_DATABASE_URL=.local/cavman-auth.db
# Auth tables are created automatically on first use; set to 0 to manage
# migrations yourself (npx auth migrate).
# CAVMAN_AUTH_AUTO_MIGRATE=1

# Optional GitHub sign-in (identity scopes only: read:user, user:email).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email for password reset and verification. With RESEND_API_KEY set, mail goes
# through Resend; otherwise, outside production, it is written to a local JSONL
# outbox (CAVMAN_DEV_OUTBOX, default .local/outbox.jsonl). In production
# without a provider, reset emails fail instead of pretending to send.
# RESEND_API_KEY=
# EMAIL_FROM="Cavman <no-reply@your-domain>"
# Require verified email before sign-in (recommended for hosted deployments).
# CAVMAN_REQUIRE_EMAIL_VERIFICATION=1
# Build emails: when a build is ready, needs a decision or stops early, its
# owner gets an email (verified addresses only; each user can turn them off in
# Settings). The web server checks the API every CAVMAN_NOTICE_POLL_SECONDS.
# CAVMAN_BUILD_EMAILS=0
# CAVMAN_NOTICE_POLL_SECONDS=60

# Cloudflare Turnstile CAPTCHA on sign-up and password-reset requests. Set both
# keys (from the Cloudflare dashboard, Turnstile) to turn it on; setting only
# one is an error. Recommended for hosted deployments.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Report server-side errors to Sentry (off when unset). No browser SDK: the CSP
# is unchanged, and bodies, cookies, query strings and auth headers are stripped
# (lib/error-reporting.ts). The same DSN as the API and workers is fine.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Invite-only beta: comma-separated emails and whole domains ("@example.com")
# allowed to create accounts, by password or GitHub. Unset means anyone can sign
# up. Existing accounts are unaffected. Setting it also requires email
# verification, so configure RESEND_API_KEY first.
# CAVMAN_SIGNUP_ALLOWLIST=you@example.com,friend@example.com

# Test suite only: CAVMAN_E2E=1 disables auth rate limiting. Never set it in production.
